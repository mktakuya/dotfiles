{
  "permissions": {
    "allow": [
      "Bash(echo *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/master.key)",
      "Read(**/credentials/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.claude.json)",
      "Read(**/.codex/auth.json)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)"
    ]
  },
  "outputStyle": "MISAKA",
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify.sh \"で入力待ち状態です\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/validate-jira-ticket.sh",
            "timeout": 10,
            "statusMessage": "Jiraチケットの内容をチェック中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify.sh \"の処理が完了しました\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.py"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "portal@smarthr-claude-plugins": true,
    "figma@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "smarthr-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "kufu/smarthr-claude-plugins"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high"
}
